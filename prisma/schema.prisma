generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id         Int      @id @default(autoincrement())
  role       String
  company    String
  experience String
  skills     Json
  projects   Json   // ✅ MUST be Json
  education  Json   // ✅ MUST be Json
}